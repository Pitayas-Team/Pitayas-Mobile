{
  "appId": "com.pitayas.swc",
  "appName": "SwC Gry",
  "webDir": "public",
  "backgroundColor": "#0b234d",
  "server": {
    "url": "https://swc.pitayas.eu",
    "errorPath": "index.html",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "swc.pitayas.eu",
      "*.pitayas.eu",
      "pitayas.eu",
      "*.rakunek.com",
      "discord.com",
      "*.discord.com",
      "cdn.discordapp.com"
    ]
  },
  "appendUserAgent": " SwC-Mobile SwC-iOS/0.5.0",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b234d",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "BackgroundRunner": {
      "label": "com.pitayas.swc.inbox",
      "src": "runners/swc-inbox.js",
      "event": "inbox",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    },
    "LocalNotifications": {
      "iconColor": "#113f87"
    }
  }
}
