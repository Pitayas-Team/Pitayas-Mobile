{
  "appId": "com.pitayas.mobile",
  "appName": "Pitayas",
  "webDir": "www",
  "backgroundColor": "#121116",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#121116"
  },
  "plugins": {
    "BackgroundRunner": {
      "label": "com.pitayas.mobile.notifications",
      "src": "runners/notifications.js",
      "event": "checkNotifications",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_pitayas",
      "iconColor": "#FF4FA6"
    }
  }
}
