{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitayas",
  "mainBinaryName": "pitayas",
  "version": "../package.json",
  "identifier": "com.pitayas.desktop",
  "build": { "frontendDist": "../../www" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Pitayas", "width": 480, "height": 860, "minWidth": 360, "minHeight": 600, "backgroundColor": "#121116" }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**", "$APPCACHE/**", "$DOCUMENT/**", "$DOWNLOAD/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "rpm", "deb"],
    "category": "Video",
    "copyright": "Copyright © 2026 Pitayas",
    "publisher": "Pitayas",
    "shortDescription": "Pitayas na komputer — filmy, moduły i tryb telewizora",
    "longDescription": "Pitayas na komputer (Fedora/Linux): ta sama aplikacja co na telefonie, z modułami aktualizowanymi przez internet, oraz tryb telewizora — film gra w przeglądarce z Widevine, a telefon działa jak pilot.",
    "homepage": "https://github.com/Pitayas-Team/Pitayas-Mobile",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
